  <Source dwd:design-time-name="4768d633-4177-4062-8e4c-3d236f564d81">
    <DataSourceViewID>DSV_Problem3_OLAP</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="09224839-0a90-4e43-8118-ac26ec2e0565">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Category Revenue Share]
 AS IIF(
    ([Measures].[Net Sales],
     [Product].[Category].DefaultMember) = 0,
    NULL,
    [Measures].[Net Sales] /
    ([Measures].[Net Sales],
     [Product].[Category].DefaultMember)
), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].AOV
 AS IIF(
    [Measures].[Order Count] = 0,
    NULL,
    [Measures].[Order Value] / [Measures].[Order Count]
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'V FACT CUSTOMER MONTHLY OFFICIAL';  
CREATE MEMBER CURRENTCUBE.[Measures].[Basket Size]
 AS IIF(
    [Measures].[Order Count] = 0,
    NULL,
    [Measures].[Basket Quantity] / [Measures].[Order Count]
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Repeat Rate]
 AS IIF(
    [Measures].[Buyer Count] = 0,
    NULL,
    [Measures].[Repeat Customer Count]
    / [Measures].[Buyer Count]
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[One-time Rate]
 AS IIF(
    [Measures].[Buyer Count] = 0,
    NULL,
    [Measures].[One-time Customer Count]
    / [Measures].[Buyer Count]
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Average Frequency]
 AS IIF(
    [Measures].[Buyer Count] = 0,
    NULL,
    [Measures].[Frequency Sum]
    / [Measures].[Buyer Count]
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Average Monetary]
 AS IIF(
    [Measures].[Buyer Count] = 0,
    NULL,
    [Measures].[Monetary Sum]
    / [Measures].[Buyer Count]
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Average Historical CLV]
 AS IIF(
    [Measures].[Buyer Count] = 0,
    NULL,
    [Measures].[Historical CLV]
    / [Measures].[Buyer Count]
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Average Days Between Orders]
 AS IIF(
    [Measures].[Repeat Interval Count] = 0,
    NULL,
    [Measures].[Avg Days Value Sum]
    / [Measures].[Repeat Interval Count]
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Average Customer Lifespan Days]
 AS IIF(
    [Measures].[Lifespan Customer Count] = 0,
    NULL,
    [Measures].[Lifespan Days Sum]
    / [Measures].[Lifespan Customer Count]
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>